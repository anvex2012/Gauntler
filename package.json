{
  "name": "gauntler",
  "version": "2.3.1",
  "description": "Gauntler - analizzatore di sicurezza file (GUI Electron + CLI)",
  "main": "electron/main.js",
  "bin": {
    "gauntler": "cli/gauntler.js"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "vite build && electron .",
    "scan": "node cli/gauntler.js",
    "test": "GAUNTLER_HOME=$(mktemp -d) node test/run-tests.js && node test/cli-tests.js && node test/advanced-tests.js && node test/regression-tests.js",
    "test:regression": "node test/regression-tests.js",
    "test:engine": "node test/run-tests.js",
    "test:cli": "node test/cli-tests.js",
    "test:advanced": "node test/advanced-tests.js",
    "icon": "electron scripts/build-icon.js",
    "package": "node scripts/package-mac.js",
    "install-cli": "node cli/gauntler.js install-command",
    "release:build": "node scripts/package-all.js"
  },
  "license": "SEE LICENSE IN licenza-gauntler.txt",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "vite": "^8.3.8"
  },
  "productName": "Gauntler"
}
